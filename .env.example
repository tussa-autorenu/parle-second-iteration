# Copy this file to `.env` and fill in your values.
# These are read at build time by Expo (the EXPO_PUBLIC_ prefix exposes them
# to the app). Restart `npx expo start -c` after changing them.

# Supabase — public available fleet (fleet_available_vehicles) + auth.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Parlé backend — share-code redeem, shared vehicle access, vehicle commands.
EXPO_PUBLIC_API_BASE_URL=https://api.parlekeys.com
EXPO_PUBLIC_PARLE_API_KEY=your_parle_external_api_key_here
